{
  "name": "taiwan-island",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --base=/Taiwan-island/",
    "build:dev": "tsc -b && vite build --mode staging --base=/Taiwan-island/dev/",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "atlas": "node tools/atlas.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
